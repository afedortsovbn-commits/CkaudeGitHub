# Скопируйте в infra/compose/.env и измените под свой сервер.
API_TAG=dev
API_REPLICAS=2
POSTGRES_PASSWORD=cc_dev_password
# Обязательно смените на сервере: случайная строка не короче 32 символов
JWT_SECRET=
# Первый администратор создаётся при первом запуске, если администраторов ещё нет
BOOTSTRAP_ADMIN_EMAIL=admin@cc.local
BOOTSTRAP_ADMIN_PASSWORD=
# Демо-данные (предприятия, темы, сотрудники) — только для стендов
SEED_DEMO=false
DEMO_PASSWORD=Demo12345!
LOG_LEVEL=info
HTTP_PORT=80
HTTPS_PORT=443
GRAFANA_PASSWORD=admin
# Образы можно брать из собственного реестра внутри контура (ops/mirror/push-registry.sh):
# POSTGRES_IMAGE=registry.local:5000/postgres:16-alpine
# NATS_IMAGE=registry.local:5000/nats:2.11-alpine
# TRAEFIK_IMAGE=registry.local:5000/traefik:v3.6
# S3_IMAGE=registry.local:5000/chrislusf/seaweedfs:4.47
